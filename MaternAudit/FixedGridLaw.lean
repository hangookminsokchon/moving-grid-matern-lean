import Mathlib.Probability.StrongLaw
import Mathlib.Analysis.Normed.Group.Tannery
import Mathlib.MeasureTheory.Integral.Prod

/-!
# Fixed-grid strong law for a countable family of complex features

The samples have a common law and are pairwise independent. For each fixed feature the
Banach-space strong law gives convergence of its empirical mean. Countability gives a
single event on which all those limits hold. A summable deterministic envelope then
permits passage through the series of squared norms. The resulting limit is the integral
of the product-feature kernel against two independent draws from the common law.
-/

noncomputable section

open Filter Finset MeasureTheory ProbabilityTheory
open scoped Topology ComplexConjugate

namespace MaternAudit.FixedGridLaw

variable {ι S Ω : Type*}

/-- Empirical mean over indices `0, …, n-1`, with value zero at `n = 0`. -/
def sampleMean (z : ℕ → ℂ) (n : ℕ) : ℂ :=
  (n : ℝ)⁻¹ • ∑ i ∈ range n, z i

theorem norm_sampleMean_le {z : ℕ → ℂ} {B : ℝ} (hz : ∀ i, ‖z i‖ ≤ B) (n : ℕ) :
    ‖sampleMean z n‖ ≤ B := by
  by_cases hn : n = 0
  · simpa [hn, sampleMean] using (norm_nonneg (z 0)).trans (hz 0)
  have hn' : (n : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hn
  rw [sampleMean, norm_smul, Real.norm_of_nonneg (by positivity : 0 ≤ (n : ℝ)⁻¹)]
  calc
    _ ≤ (n : ℝ)⁻¹ * ∑ i ∈ range n, ‖z i‖ :=
      mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)
    _ ≤ (n : ℝ)⁻¹ * ∑ _i ∈ range n, B :=
      mul_le_mul_of_nonneg_left (sum_le_sum fun i _ ↦ hz i) (by positivity)
    _ = B := by simp [nsmul_eq_mul, ← mul_assoc, hn']

/-- Sample energy for fixed weights and features. The two sums use different indices. -/
def empiricalEnergy (c : ι → ℝ) (φ : ι → S → ℂ) (x : ℕ → S) (n : ℕ) : ℝ :=
  ∑' k, c k * ‖sampleMean (fun i ↦ φ k (x i)) n‖ ^ 2

section Probability

variable [Countable ι] [MeasurableSpace S] [MeasurableSpace Ω]
    {μ : Measure Ω} [IsProbabilityMeasure μ] {X : ℕ → Ω → S}

/-- The envelope need only hold almost surely under the common marginal law.
Real weights may have either sign, provided the absolute weighted envelope is summable. -/
theorem empiricalEnergy_tendsto_ae_of_envelope
    (hind : Pairwise fun i j ↦ IndepFun (X i) (X j) μ)
    (hlaw : ∀ i, IdentDistrib (X i) (X 0) μ μ)
    {φ : ι → S → ℂ} (hφ : ∀ k, Measurable (φ k)) {c B : ι → ℝ}
    (hb : ∀ k, ∀ᵐ ω ∂μ, ‖φ k (X 0 ω)‖ ≤ B k)
    (hs : Summable fun k ↦ |c k| * B k ^ 2) :
    ∀ᵐ ω ∂μ, Tendsto (empiricalEnergy c φ (fun i ↦ X i ω)) atTop
      (𝓝 (∑' k, c k * ‖∫ t, φ k (X 0 t) ∂μ‖ ^ 2)) := by
  have hcoord : ∀ᵐ ω ∂μ, ∀ k,
      Tendsto (sampleMean (fun i ↦ φ k (X i ω))) atTop (𝓝 (∫ t, φ k (X 0 t) ∂μ)) := by
    apply ae_all_iff.2
    intro k
    apply strong_law_ae (fun i ↦ φ k ∘ X i)
    · exact (integrable_const (B k)).mono'
        (((hlaw 0).comp (hφ k)).aestronglyMeasurable_fst) (hb k)
    · exact fun i j hij ↦ (hind hij).comp (hφ k) (hφ k)
    · exact fun i ↦ (hlaw i).comp (hφ k)
  have hsample : ∀ᵐ ω ∂μ, ∀ k i, ‖φ k (X i ω)‖ ≤ B k := by
    refine ae_all_iff.2 fun k ↦ ae_all_iff.2 fun i ↦ ?_
    exact (hlaw i).symm.ae_snd (p := fun x ↦ ‖φ k x‖ ≤ B k)
      (measurableSet_le (hφ k).norm measurable_const) (hb k)
  filter_upwards [hcoord, hsample] with ω hω hbound
  apply tendsto_tsum_of_dominated_convergence hs
  · exact fun k ↦ tendsto_const_nhds.mul ((hω k).norm.pow 2)
  · refine Eventually.of_forall fun n k ↦ ?_
    rw [norm_mul, Real.norm_eq_abs (c k), Real.norm_of_nonneg (sq_nonneg _)]
    exact mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (norm_nonneg _) (norm_sampleMean_le (hbound k) n) 2) (abs_nonneg _)

/-- Uniformly bounded complex features and summable nonnegative weights. -/
theorem empiricalEnergy_tendsto_ae
    (hind : Pairwise fun i j ↦ IndepFun (X i) (X j) μ)
    (hlaw : ∀ i, IdentDistrib (X i) (X 0) μ μ)
    {φ : ι → S → ℂ} (hφ : ∀ k, Measurable (φ k)) {c : ι → ℝ}
    (hc : ∀ k, 0 ≤ c k) (hs : Summable c) {B : ℝ} (hb : ∀ k x, ‖φ k x‖ ≤ B) :
    ∀ᵐ ω ∂μ, Tendsto (empiricalEnergy c φ (fun i ↦ X i ω)) atTop
      (𝓝 (∑' k, c k * ‖∫ t, φ k (X 0 t) ∂μ‖ ^ 2)) := by
  apply empiricalEnergy_tendsto_ae_of_envelope hind hlaw hφ (B := fun _ ↦ B)
  · exact fun k ↦ Eventually.of_forall fun ω ↦ hb k (X 0 ω)
  · simpa only [abs_of_nonneg (hc _)] using hs.mul_right (B ^ 2)

end Probability

/-- Real part of the Hermitian kernel generated by the features and weights. -/
def productKernel (c : ι → ℝ) (φ : ι → S → ℂ) (x y : S) : ℝ :=
  ∑' k, c k * (φ k x * conj (φ k y)).re

/-- The V-statistic over all ordered pairs, including the diagonal. -/
def pairMean (K : S → S → ℝ) (x : ℕ → S) (n : ℕ) : ℝ :=
  (n : ℝ)⁻¹ ^ 2 * ∑ i ∈ range n, ∑ j ∈ range n, K (x i) (x j)

private theorem sq_norm_sampleMean (z : ℕ → ℂ) (n : ℕ) :
    ‖sampleMean z n‖ ^ 2 =
      (n : ℝ)⁻¹ ^ 2 * ∑ i ∈ range n, ∑ j ∈ range n, (z i * conj (z j)).re := by
  rw [sampleMean, norm_smul, Real.norm_of_nonneg (by positivity : 0 ≤ (n : ℝ)⁻¹), mul_pow]
  congr 1
  calc
    ‖∑ i ∈ range n, z i‖ ^ 2 = ((∑ i ∈ range n, z i) * conj (∑ j ∈ range n, z j)).re := by
      rw [Complex.mul_conj, Complex.ofReal_re, Complex.sq_norm]
    _ = _ := by
      simp only [map_sum, sum_mul, mul_sum, Complex.re_sum]
      exact sum_comm

private theorem norm_mul_conj_le {u v : ℂ} {A B : ℝ} (hu : ‖u‖ ≤ A) (hv : ‖v‖ ≤ B) :
    ‖u * conj v‖ ≤ A * B := by
  rw [norm_mul, Complex.norm_conj]
  exact mul_le_mul hu hv (norm_nonneg _) ((norm_nonneg _).trans hu)

private theorem norm_productTerm_le {u v : ℂ} {B : ℝ} (a : ℝ)
    (hu : ‖u‖ ≤ B) (hv : ‖v‖ ≤ B) : ‖a * (u * conj v).re‖ ≤ |a| * B ^ 2 := by
  rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, sq]
  apply mul_le_mul_of_nonneg_left _ (abs_nonneg a)
  exact (Complex.abs_re_le_norm _).trans (norm_mul_conj_le hu hv)

/-- Exact finite-sample identity for the infinite feature expansion. Absolute summability
justifies interchanging the feature sum with each finite sample sum. -/
theorem empiricalEnergy_eq_pairMean {c B : ι → ℝ} {φ : ι → S → ℂ} (x : ℕ → S)
    (hb : ∀ k i, ‖φ k (x i)‖ ≤ B k) (hs : Summable fun k ↦ |c k| * B k ^ 2) (n : ℕ) :
    empiricalEnergy c φ x n = pairMean (productKernel c φ) x n := by
  let F (i j : ℕ) (k : ι) := c k * (φ k (x i) * conj (φ k (x j))).re
  have hF (i j : ℕ) : Summable (F i j) :=
    hs.of_norm_bounded _ fun k ↦ norm_productTerm_le _ (hb k i) (hb k j)
  have hswap : (∑' k, ∑ i ∈ range n, ∑ j ∈ range n, F i j k) =
      ∑ i ∈ range n, ∑ j ∈ range n, ∑' k, F i j k := by
    rw [Summable.tsum_finsetSum (fun i _ ↦ summable_sum fun j (_ : j ∈ range n) ↦ hF i j)]
    exact sum_congr rfl fun i _ ↦ Summable.tsum_finsetSum (fun j (_ : j ∈ range n) ↦ hF i j)
  calc
    empiricalEnergy c φ x n =
        ∑' k, (n : ℝ)⁻¹ ^ 2 * ∑ i ∈ range n, ∑ j ∈ range n, F i j k := by
      refine tsum_congr fun k ↦ ?_
      rw [sq_norm_sampleMean, mul_left_comm]
      simp only [F, mul_sum]
    _ = pairMean (productKernel c φ) x n := by
      rw [tsum_mul_left, hswap]
      rfl

/-- Integration against the product of the marginal law with itself factors each
rank-one term. The weighted envelope also justifies integrating the series termwise. -/
theorem integral_productKernel [Countable ι] [MeasurableSpace S]
    (ν : Measure S) [IsProbabilityMeasure ν]
    {φ : ι → S → ℂ} (hφ : ∀ k, Measurable (φ k)) {c B : ι → ℝ}
    (hb : ∀ k x, ‖φ k x‖ ≤ B k) (hs : Summable fun k ↦ |c k| * B k ^ 2) :
    ∫ p : S × S, productKernel c φ p.1 p.2 ∂ν.prod ν =
      ∑' k, c k * ‖∫ x, φ k x ∂ν‖ ^ 2 := by
  let F (k : ι) (p : S × S) := φ k p.1 * conj (φ k p.2)
  have hm (k : ι) : Measurable (F k) :=
    ((hφ k).comp measurable_fst).mul
      (Complex.continuous_conj.measurable.comp ((hφ k).comp measurable_snd))
  have hi (k : ι) : Integrable (F k) (ν.prod ν) :=
    (integrable_const (B k * B k)).mono' (hm k).aestronglyMeasurable
      (Eventually.of_forall fun p ↦ norm_mul_conj_le (hb k p.1) (hb k p.2))
  let G (k : ι) (p : S × S) := c k * (F k p).re
  have hG (k : ι) : Integrable (G k) (ν.prod ν) := (hi k).re.const_mul (c k)
  have hGsum : Summable fun k ↦ ∫ p, ‖G k p‖ ∂ν.prod ν := by
    refine Summable.of_nonneg_of_le (fun _ ↦ integral_nonneg fun _ ↦ norm_nonneg _) (fun k ↦ ?_) hs
    calc
      _ ≤ ∫ _p : S × S, |c k| * B k ^ 2 ∂ν.prod ν :=
        integral_mono (hG k).norm (integrable_const _)
          (fun p ↦ norm_productTerm_le _ (hb k p.1) (hb k p.2))
      _ = _ := by simp
  change (∫ p, ∑' k, G k p ∂ν.prod ν) = _
  rw [← integral_tsum_of_summable_integral_norm hG hGsum]
  refine tsum_congr fun k ↦ ?_
  change (∫ p, c k * RCLike.re (F k p) ∂ν.prod ν) = _
  rw [integral_const_mul, integral_re (hi k)]
  change c k * (∫ p, φ k p.1 * conj (φ k p.2) ∂ν.prod ν).re = _
  rw [integral_prod_mul (φ k) (fun x ↦ conj (φ k x)), integral_conj, Complex.mul_conj,
    Complex.ofReal_re, Complex.normSq_eq_norm_sq]

/-- Almost sure convergence of the ordered pair average to its independent-pair
population integral. The two factors have the common marginal law of the samples. -/
theorem pairMean_productKernel_tendsto_ae
    [Countable ι] [MeasurableSpace S] [MeasurableSpace Ω]
    {μ : Measure Ω} [IsProbabilityMeasure μ] {X : ℕ → Ω → S}
    (hind : Pairwise fun i j ↦ IndepFun (X i) (X j) μ)
    (hlaw : ∀ i, IdentDistrib (X i) (X 0) μ μ)
    {φ : ι → S → ℂ} (hφ : ∀ k, Measurable (φ k)) {c B : ι → ℝ}
    (hb : ∀ k x, ‖φ k x‖ ≤ B k) (hs : Summable fun k ↦ |c k| * B k ^ 2) :
    ∀ᵐ ω ∂μ, Tendsto (pairMean (productKernel c φ) (fun i ↦ X i ω)) atTop
      (𝓝 (∫ p : S × S, productKernel c φ p.1 p.2 ∂(μ.map (X 0)).prod (μ.map (X 0)))) := by
  have hX := (hlaw 0).aemeasurable_fst
  letI := isProbabilityMeasure_map hX
  rw [integral_productKernel _ hφ hb hs]
  simp_rw [integral_map hX (hφ _).aestronglyMeasurable]
  have he := empiricalEnergy_tendsto_ae_of_envelope hind hlaw hφ
    (fun k ↦ Eventually.of_forall fun ω ↦ hb k (X 0 ω)) hs
  filter_upwards [he] with ω hω
  exact hω.congr' (Eventually.of_forall fun n ↦
    empiricalEnergy_eq_pairMean _ (fun k i ↦ hb k (X i ω)) hs n)

/-- Complex Hermitian Gram kernel. Its squared modulus gives the contribution of
one ordered pair of sample indices to the squared Frobenius norm. -/
def gramKernel (c : ι → ℝ) (φ : ι → S → ℂ) (x y : S) : ℂ :=
  ∑' k, (c k : ℂ) * (φ k x * conj (φ k y))

/-- The features on the product index set arising on squaring a Gram entry. -/
def pairFeature (φ : ι → S → ℂ) (p : ι × ι) (x : S) : ℂ :=
  φ p.1 x * conj (φ p.2 x)

/-- The squared modulus of the full Gram kernel is itself a product-feature kernel.
The double series is absolutely summable under the original weighted envelope. -/
theorem sq_norm_gramKernel_eq_productKernel
    {φ : ι → S → ℂ} {c B : ι → ℝ} (hb : ∀ k x, ‖φ k x‖ ≤ B k)
    (hs : Summable fun k ↦ |c k| * B k ^ 2) (x y : S) :
    ‖gramKernel c φ x y‖ ^ 2 =
      productKernel (fun p : ι × ι ↦ c p.1 * c p.2) (pairFeature φ) x y := by
  let a (k : ι) : ℂ := (c k : ℂ) * (φ k x * conj (φ k y))
  have ha : Summable fun k ↦ ‖a k‖ := by
    refine Summable.of_nonneg_of_le (fun _ ↦ norm_nonneg _) (fun k ↦ ?_) hs
    change ‖(c k : ℂ) * (φ k x * conj (φ k y))‖ ≤ _
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, sq]
    exact mul_le_mul_of_nonneg_left (norm_mul_conj_le (hb k x) (hb k y)) (abs_nonneg _)
  have hca : Summable fun k ↦ ‖conj (a k)‖ := by simpa only [Complex.norm_conj] using ha
  have hconj : conj (∑' k, a k) = ∑' k, conj (a k) :=
    (Complex.hasSum_conj'.2 ha.of_norm.hasSum).tsum_eq.symm
  calc
    ‖gramKernel c φ x y‖ ^ 2 = ((∑' k, a k) * conj (∑' k, a k)).re := by
      rw [Complex.mul_conj, Complex.ofReal_re, Complex.normSq_eq_norm_sq]
      rfl
    _ = (∑' p : ι × ι, a p.1 * conj (a p.2)).re := by
      rw [hconj, tsum_mul_tsum_of_summable_norm ha hca]
    _ = _ := by
      rw [Complex.re_tsum (summable_mul_of_summable_norm ha hca)]
      refine tsum_congr fun p ↦ ?_
      change (a p.1 * conj (a p.2)).re =
        (c p.1 * c p.2) * (pairFeature φ p x * conj (pairFeature φ p y)).re
      rw [← Complex.re_ofReal_mul]
      apply congrArg Complex.re
      simp only [a, pairFeature, map_mul, Complex.conj_ofReal, starRingEnd_self_apply,
        Complex.ofReal_mul]
      ac_rfl

/-- Fixed-grid strong law for the squared Frobenius norm divided by `n²`. Both
diagonal and off-diagonal entries are included. Its limit is the squared kernel
integrated against two independent samples from the common law. -/
theorem pairMean_sq_norm_gramKernel_tendsto_ae
    [Countable ι] [MeasurableSpace S] [MeasurableSpace Ω]
    {μ : Measure Ω} [IsProbabilityMeasure μ] {X : ℕ → Ω → S}
    (hind : Pairwise fun i j ↦ IndepFun (X i) (X j) μ)
    (hlaw : ∀ i, IdentDistrib (X i) (X 0) μ μ)
    {φ : ι → S → ℂ} (hφ : ∀ k, Measurable (φ k)) {c B : ι → ℝ}
    (hb : ∀ k x, ‖φ k x‖ ≤ B k) (hs : Summable fun k ↦ |c k| * B k ^ 2) :
    ∀ᵐ ω ∂μ, Tendsto (pairMean (fun x y ↦ ‖gramKernel c φ x y‖ ^ 2) (fun i ↦ X i ω)) atTop
      (𝓝 (∫ p : S × S, ‖gramKernel c φ p.1 p.2‖ ^ 2 ∂(μ.map (X 0)).prod (μ.map (X 0)))) := by
  have hmeas (p : ι × ι) : Measurable (pairFeature φ p) :=
    (hφ p.1).mul (Complex.continuous_conj.measurable.comp (hφ p.2))
  have hbound (p : ι × ι) (x : S) : ‖pairFeature φ p x‖ ≤ B p.1 * B p.2 :=
    norm_mul_conj_le (hb p.1 x) (hb p.2 x)
  have hnonneg : 0 ≤ fun k ↦ |c k| * B k ^ 2 := fun k ↦ mul_nonneg (abs_nonneg _) (sq_nonneg _)
  have hsum : Summable fun p : ι × ι ↦ |c p.1 * c p.2| * (B p.1 * B p.2) ^ 2 :=
    (hs.mul_of_nonneg hs hnonneg hnonneg).congr fun p ↦ by
      simp only [abs_mul, mul_pow]
      ac_rfl
  simp_rw [sq_norm_gramKernel_eq_productKernel hb hs]
  exact pairMean_productKernel_tendsto_ae hind hlaw hmeas hbound hsum

end MaternAudit.FixedGridLaw
